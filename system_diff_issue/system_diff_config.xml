<?xml version='1.1' encoding='UTF-8'?>
<project>
  <actions/>
  <description>&apos;Job for getting a diff of two systems and their included components on a source code level.&lt;br&gt;&apos;
&apos;One set of reports is created based on a diff of all included projects.&lt;br&gt;&apos;
&apos;One additional set of reports is optionally created where specified projects are excluded from the diff.&apos;
&lt;!-- Managed by Jenkins Job Builder --&gt;</description>
  <keepDependencies>false</keepDependencies>
  <properties>
    <hudson.model.ParametersDefinitionProperty>
      <parameterDefinitions>
        <hudson.model.StringParameterDefinition>
          <name>SYSTEM_LABEL_1</name>
          <description>[Mandatory] First system label, e.g. &apos;64.1.A.1.371&apos;.
</description>
          <defaultValue></defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>SYSTEM_LABEL_2</name>
          <description>[Mandatory] Second system label, e.g. &apos;64.1.A.0.859&apos;.
</description>
          <defaultValue></defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>EXCLUDE_PROJECTS</name>
          <description>[Optional] Space separated names of project to exclude from the diff
</description>
          <defaultValue>platform/vendor/semc/build/system-snapshot platform/vendor/semc/build/android-qssi-packages platform/vendor/semc/build/android-target-packages platform/vendor/semc/build/pld-packages</defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
      </parameterDefinitions>
    </hudson.model.ParametersDefinitionProperty>
  </properties>
