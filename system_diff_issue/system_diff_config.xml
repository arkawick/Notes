  <canRoam>false</canRoam>
  <disabled>false</disabled>
  <blockBuildWhenDownstreamBuilding>false</blockBuildWhenDownstreamBuilding>
  <blockBuildWhenUpstreamBuilding>false</blockBuildWhenUpstreamBuilding>
  <triggers/>
  <concurrentBuild>true</concurrentBuild>
  <builders>
    <hudson.tasks.Shell>
      <command>#!/bin/bash -ex
if [ -e $HOME/.netrc ]; then
   rm -rf $HOME/.netrc
fi
cat $NETRC_FILE &gt;&gt; $HOME/.netrc
cat $NETRC_JK_FILE &gt;&gt; $HOME/.netrc

chmod og-rw $HOME/.netrc
</command>
      <configuredLocalRules/>
    </hudson.tasks.Shell>
    <hudson.tasks.Shell>
      <command>#!/bin/bash -ex

# If the cm_tools git exists, make sure it&apos;s up to date.  If it
# does not exist yet, clone it.
if [ -d cm_tools ] ; then
    ( cd cm_tools &amp;&amp; git fetch &amp;&amp; git checkout origin/master )
else
    git clone git://review.ptc.sony.co.jp/semctools/cm_tools -b master
fi

cm_tools/hudson-scripts/system-diff.sh
</command>
      <configuredLocalRules/>
    </hudson.tasks.Shell>
